{
  "extends": "../../tsconfig.base.json",
  "include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "next.config.ts", "instrumentation.ts", "instrumentation-client.ts", "sentry.server.config.ts"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts", "**/*.test.tsx"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "plugins": [{"name":"next"}],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
