# Copy to .env.local for local development against the Supabase DEV project.
# Both values are public (browser-safe); data is protected by RLS. Never put a
# service_role/secret key here: the app does not need one.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
